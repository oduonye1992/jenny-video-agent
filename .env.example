# Jenny Video Agent — API keys
# Copy to .env and fill in your keys: cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────────

# FAL — image gen (Nano Banana), video gen (Kling, Veo, Sora, etc.), upscale (Topaz)
FAL_KEY=your_fal_key_here

# ElevenLabs — TTS narration, voice design, music generation
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Freepik — Magnific image upscaler (talking head anchor frames)
FREEPIK_API_KEY=your_freepik_api_key_here

# Supabase — image hosting (public URLs for APIs that require them)
SUPABASE_URL=your_supabase_url_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# ── Optional ──────────────────────────────────────────────────────────────

# Google Gemini — video analysis (describe-clips, find-clips)
GOOGLE_API_KEY=your_google_api_key_here

# Anthropic — Claude verification pass
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Airtable — batch production pipeline
# Get a Personal Access Token with schema.bases:read, data.records:read/write
AIRTABLE_API_KEY=your_airtable_personal_access_token_here
AIRTABLE_BASE_ID=your_airtable_base_id_here
AIRTABLE_TABLE_ID=your_airtable_table_id_here
